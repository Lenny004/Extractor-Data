# Copia este archivo a `.env` y personaliza los valores.
# `.env` no debe subirse al repositorio (está en .gitignore).

# Entorno de ejecución del backend: development | production | test
NODE_ENV=development

# Puerto HTTP del API Express
PORT=3000

# Origen permitido para CORS (URL exacta del frontend, sin barra final)
CORS_ORIGIN=http://localhost:4200

# Intervalo en milisegundos para limpiar subidas temporales en disco (por defecto 5 minutos)
UPLOAD_CLEANUP_INTERVAL_MS=300000

# URL pública del API (sin barra final). Útil para documentación, scripts o el frontend.
API_PUBLIC_URL=http://localhost:3000

# --- Opcional: rellenar solo si aplica ---

# Secreto para JWT o sesiones si añades autenticación (valor largo y aleatorio en producción)
# AUTH_JWT_SECRET=

# Cadena de conexión si integras base de datos
# DATABASE_URL=

# Clave para endpoints internos o administración (cabecera Authorization, etc.)
# INTERNAL_API_KEY=
